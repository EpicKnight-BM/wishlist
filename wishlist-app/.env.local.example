# Environment variables — copy this file to .env.local and fill in the values

# Supabase — find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The public URL of your app (used for OAuth redirect)
# During development use: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
